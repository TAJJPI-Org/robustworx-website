---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import Backdrop from '../components/Backdrop.astro';
import { photos } from '../data/photos';
import { site, telHref } from '../data/site';

const updated = 'August 2026';
---

<BaseLayout
  title="Privacy"
  description="How RobustWorx handles personal information collected through this website."
>
  <PageIntro
    eyebrow="Privacy"
    title="Privacy"
    variant="lime"
    motif="grid"
    photo={photos.trenchSite}
  />

  <section class="section legal has-bg">
    <Backdrop photo={photos.excavatorSunset} side="full" opacity={0.08} />
    <div class="wrap wrap--content prose">
      <p class="legal__updated">Last updated: {updated}</p>

      <p class="lead">
        This page explains what happens to information you enter on this website. It is written to
        describe how the site actually works.
      </p>

      <h2>Who this is about</h2>
      <p>
        This website is operated by {site.name}. For anything relating to privacy, contact {
          site.contactName
        } on <a href={telHref()}>{site.phoneDisplay}</a>.
      </p>

      <h2>What the website collects</h2>
      <p>
        This is a static website. The job enquiry form on the contact page does not submit your
        details to this website or store them here. When you use it, the form builds a summary of
        what you entered and hands that text to your own device — either to your messaging app, so
        you can send it to Scott yourself, or to your clipboard so you can paste it somewhere.
        Nothing is transmitted to RobustWorx until you send it.
      </p>
      <p>
        If a form submission service is connected to this website in future, this page will be
        updated to name it and describe what it does with your information.
      </p>

      <h2>Information you send directly</h2>
      <p>
        When you call, text or email RobustWorx, the information you provide — such as your name,
        contact details, job location and what the work involves — is used to respond to your
        enquiry, assess the job and carry out any work that follows. It is not sold, and it is not
        provided to third parties except where it is necessary to carry out the work you have asked
        for, or where the law requires it.
      </p>

      <h2>Hosting and server logs</h2>
      <p>
        Like most websites, the service that hosts this site may automatically record technical
        information such as IP address, browser type, the pages requested and the time of the
        request. These logs are generated by the hosting provider for security and operational
        purposes.
      </p>

      <h2>Cookies and analytics</h2>
      <p>
        This website does not set cookies for tracking or advertising, and no third-party analytics
        or advertising scripts are loaded. If that changes, this page will be updated first.
      </p>

      <h2>Fonts and third-party content</h2>
      <p>
        Typefaces used on this site are served from the site's own domain rather than from a
        third-party font service, so viewing the site does not send a request to an external font
        provider.
      </p>

      <h2>Accessing or correcting your information</h2>
      <p>
        If you would like to know what information RobustWorx holds about you, or want it corrected
        or deleted, contact {site.contactName} on <a href={telHref()}>{site.phoneDisplay}</a>.
      </p>

      <h2>Changes to this page</h2>
      <p>
        This page may be updated as the website or the business changes. The date at the top shows
        when it was last revised.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .legal__updated {
    font-family: var(--f-display);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--c-orange);
    margin-bottom: 1.75rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--c-line);
  }
  .legal :global(p) {
    color: #c8c8c3;
  }
  .legal :global(.lead) {
    color: #d8d8d2;
  }
</style>
