---
import { Image } from 'astro:assets';
import type { Photo } from '../data/photos';

/**
 * Supplied-photo figure. Every image on the site goes through this so the
 * treatment is consistent: cover-cropped to a fixed ratio, responsive srcset,
 * optional hi-vis tag and a factual caption. See src/data/photos.ts.
 */
interface Props {
  photo: Photo;
  /** Aspect ratio for the crop, as a CSS ratio. */
  ratio?: string;
  widths?: number[];
  sizes?: string;
  loading?: 'lazy' | 'eager';
  /** Small label pinned to a corner of the image. */
  tag?: string;
  /** Show the photo's caption beneath it. */
  caption?: boolean;
  /** Override the photo's default object-position. */
  focus?: string;
  class?: string;
}

const {
  photo,
  ratio = '4 / 3',
  widths = [480, 800, 1200, 1600],
  sizes = '(min-width: 1100px) 50vw, 100vw',
  loading = 'lazy',
  tag,
  caption = false,
  focus,
  class: className = '',
} = Astro.props;
---

<figure class={`photo ${className}`} style={`--ratio:${ratio};--focus:${focus ?? photo.focus}`}>
  <div class="photo__frame">
    <Image
      src={photo.src}
      alt={photo.alt}
      widths={widths}
      sizes={sizes}
      loading={loading}
      decoding={loading === 'eager' ? 'sync' : 'async'}
      fetchpriority={loading === 'eager' ? 'high' : 'auto'}
      class="photo__img"
    />
    {tag && <span class="photo__tag">{tag}</span>}
    <span class="photo__corner" aria-hidden="true"></span>
  </div>
  {caption && <figcaption class="photo__cap">{photo.caption}</figcaption>}
</figure>

<style>
  .photo {
    margin: 0;
    min-width: 0;
  }
  .photo__frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: var(--ratio);
    background: var(--c-surface-2);
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 22px), calc(100% - 22px) 100%, 0 100%);
  }
  .photo__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--focus, 50% 50%);
    transform: scale(1.001);
    transition: transform 1.1s var(--ease);
  }
  .photo:hover .photo__img,
  .photo:focus-within .photo__img {
    transform: scale(1.04);
  }
  .photo__tag {
    position: absolute;
    top: 0;
    left: 0;
    padding: 0.4rem 0.75rem;
    background: var(--c-lime);
    color: var(--c-black);
    font-family: var(--f-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    line-height: 1;
  }
  .photo__corner {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 44px;
    height: 22px;
    background-image: repeating-linear-gradient(
      -45deg,
      var(--c-orange) 0 6px,
      transparent 6px 12px
    );
    opacity: 0.9;
  }
  .photo__cap {
    margin-top: 0.7rem;
    padding-left: 0.85rem;
    border-left: 3px solid var(--c-orange);
    font-size: var(--t-small);
    line-height: 1.5;
    color: var(--c-muted);
  }
  @media (prefers-reduced-motion: reduce) {
    .photo__img,
    .photo:hover .photo__img {
      transform: none;
    }
  }
</style>
