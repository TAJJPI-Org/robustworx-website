---
import { Image } from 'astro:assets';
import type { Photo } from '../data/photos';

interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  /** Accent + background motif. Keeps pages related but not identical. */
  variant?: 'lime' | 'orange' | 'plum';
  motif?: 'grid' | 'centreline' | 'chevron';
  /** Supplied photo shown behind the right-hand side of the intro. */
  photo?: Photo;
}
const { eyebrow, title, lead, variant = 'lime', motif = 'grid', photo } = Astro.props;
---

<section class={`pi pi--${variant} pi--${motif} ${photo ? 'pi--photo' : ''}`}>
  {
    photo && (
      <div class="pi__photo" aria-hidden="true">
        <Image
          src={photo.src}
          alt=""
          widths={[720, 1080, 1440]}
          sizes="(min-width: 1000px) 62vw, 100vw"
          loading="eager"
          decoding="async"
          fetchpriority="high"
          class="pi__img"
          style={`object-position:${photo.focus}`}
        />
        <span class="pi__shade" />
      </div>
    )
  }
  <div class="wrap pi__inner">
    <p class="label">{eyebrow}</p>
    <h1 class="pi__title">{title}</h1>
    {lead && <p class="lead pi__lead">{lead}</p>}
    <slot />
  </div>
  <div class="pi__rule" aria-hidden="true"></div>
</section>

<style>
  .pi {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2.75rem, 1.5rem + 5vw, 5.5rem) clamp(2rem, 1.2rem + 3vw, 3.5rem);
    background: var(--c-black);
  }
  .pi__inner {
    position: relative;
    z-index: 1;
  }
  .pi__title {
    margin-top: 1rem;
    font-size: var(--t-h1);
    max-width: 20ch;
  }
  .pi__lead {
    margin-top: 1.1rem;
  }
  .pi__rule {
    position: absolute;
    inset: auto 0 0 0;
    height: 4px;
    z-index: 2;
  }

  /* Photo backdrop */
  .pi__photo {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .pi__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.55;
  }
  .pi__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        var(--c-black) 0%,
        rgba(12, 12, 14, 0.92) 42%,
        rgba(12, 12, 14, 0.45) 100%
      ),
      linear-gradient(0deg, var(--c-black) 0%, rgba(12, 12, 14, 0) 55%);
  }
  .pi--photo {
    padding-block: clamp(3.5rem, 2rem + 6vw, 7.5rem) clamp(2.5rem, 1.5rem + 3.5vw, 4.5rem);
  }
  .pi--photo::before {
    display: none;
  }
  .pi--photo .pi__lead {
    color: #e2e2dc;
  }
  @media (max-width: 999px) {
    .pi__shade {
      background:
        linear-gradient(
          90deg,
          var(--c-black) 0%,
          rgba(12, 12, 14, 0.85) 60%,
          rgba(12, 12, 14, 0.6) 100%
        ),
        linear-gradient(0deg, var(--c-black) 0%, rgba(12, 12, 14, 0) 55%);
    }
    .pi__img {
      opacity: 0.45;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .pi__img {
      animation: pi-settle 8s var(--ease) both;
    }
  }
  @keyframes pi-settle {
    from {
      transform: scale(1.06);
    }
    to {
      transform: scale(1);
    }
  }

  /* Accent */
  .pi--lime .label {
    color: var(--c-lime);
  }
  .pi--lime .label::before {
    background: var(--c-lime);
  }
  .pi--lime .pi__rule {
    background: linear-gradient(90deg, var(--c-lime) 0 22%, var(--c-line) 22% 100%);
  }

  .pi--orange .label {
    color: var(--c-orange);
  }
  .pi--orange .label::before {
    background: var(--c-orange);
  }
  .pi--orange .pi__rule {
    background: linear-gradient(90deg, var(--c-orange) 0 22%, var(--c-line) 22% 100%);
  }

  .pi--plum {
    background: linear-gradient(180deg, var(--c-plum-deep) 0%, var(--c-black) 78%);
  }
  .pi--plum .pi__rule {
    background: linear-gradient(90deg, var(--c-purple) 0 22%, var(--c-line) 22% 100%);
  }

  /* Motif */
  .pi--grid::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.035) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
    background-size: 76px 76px;
    mask-image: linear-gradient(120deg, #000 0%, transparent 62%);
  }
  .pi--centreline::before {
    content: '';
    position: absolute;
    inset: 0 0 0 auto;
    width: min(46%, 520px);
    background-image: repeating-linear-gradient(-68deg, var(--c-line) 0 3px, transparent 3px 46px);
    mask-image: linear-gradient(90deg, transparent 0%, #000 70%);
  }
  .pi--chevron::before {
    content: '';
    position: absolute;
    inset: auto 0 -20px auto;
    width: min(52%, 620px);
    height: 190px;
    background-image: repeating-linear-gradient(
      -45deg,
      rgba(255, 106, 19, 0.28) 0 16px,
      transparent 16px 32px
    );
    mask-image: linear-gradient(90deg, transparent 0%, #000 85%);
  }
</style>
