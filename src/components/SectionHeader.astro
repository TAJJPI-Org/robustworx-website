---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  align?: 'start' | 'split';
  accent?: 'lime' | 'orange';
}
const { eyebrow, title, lead, align = 'start', accent = 'lime' } = Astro.props;
---

<div class={`sh sh--${align}`}>
  <div class="sh__head">
    {eyebrow && <p class={`label ${accent === 'orange' ? 'label--orange' : ''}`}>{eyebrow}</p>}
    <h2 class="sh__title">{title}</h2>
  </div>
  {
    (lead || Astro.slots.has('default')) && (
      <div class="sh__aside">
        {lead && <p class="lead">{lead}</p>}
        <slot />
      </div>
    )
  }
</div>

<style>
  .sh {
    display: grid;
    gap: 1.25rem;
    margin-bottom: clamp(1.75rem, 1.2rem + 2vw, 3rem);
  }
  .sh__head .label {
    margin-bottom: 0.9rem;
  }
  .sh__title {
    max-width: 22ch;
  }
  @media (min-width: 900px) {
    .sh--split {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      gap: clamp(2rem, 1rem + 3vw, 4rem);
      align-items: end;
    }
    .sh--split .sh__aside {
      padding-bottom: 0.35rem;
    }
  }
</style>
